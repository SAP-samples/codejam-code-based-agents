# SAP AI Core credentials
# Use one of the following authentication methods:

# Option 1 (Local Development): Paste the full service key JSON as a single line
AICORE_SERVICE_KEY=''

# Option 2 (Cloud Foundry): Credentials are picked up automatically from VCAP_SERVICES binding

# SAP AI Core configuration
RESOURCE_GROUP=ai-agents-codejam

# Model to use (e.g. gpt-4o, claude-3-opus)
MODEL_NAME=gpt-4o

# Grounding pipeline ID (from SAP AI Launchpad > Generative AI Hub > Grounding Management)
GROUNDING_PIPELINE_ID=

# --- Observability: LangSmith (exercises 02-06) ---
# Sign up at https://smith.langchain.com and create a project named codejam-investigation
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=codejam-investigation

# --- Observability: OpenTelemetry / Traceloop (exercise 07b) ---
# Start Jaeger locally: docker run --rm --name jaeger -p 16686:16686 -p 4318:4318 jaegertracing/all-in-one:latest
# Then open http://localhost:16686 to view traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

